# Put only the keys you have. One provider is enough to start.
ANYAPI_API_KEY=
GOANYAPI_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TWITTERAPI_IO_KEY=
YIR_API_KEY=

# Optional Google Ads Keyword Planner route. Defaults to ~/.getcheapapi/google-ads-oauth.json.
# GOOGLE_ADS_OAUTH_FILE=/path/to/authorized_user.json
# Select an Ads client if OAuth can access more than one.
# GOOGLE_ADS_CUSTOMER_ID=
# Set the manager account ID when accessing the client through a manager.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Or keep keys in another .env and point to it (no second copy):
# GETCHEAPAPI_ENV_FILE=/path/to/your/.env
