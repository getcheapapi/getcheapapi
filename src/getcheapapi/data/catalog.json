{
  "_doc": "Capability -> candidate routes. Body templates: \"$x\" required input field, \"$x?\" optional (dropped when absent), \"$x=default\" default value, \"$x|join\" comma-joined list, \"$item\" one element in each-mode. \"each\": one call per element of that input list. \"chunk\": split that input list into calls of at most size elements. \"price_per\": the call price is multiplied by the length of that input list. \"note\" is shown when comparing; routes whose data differs say so there.",
  "serp.google": {
    "description": "Google organic results, top 10 for one query",
    "input": {"query": "search query", "gl": "country code, e.g. us (optional)", "hl": "language, e.g. en (optional)"},
    "example": {"query": "cheap serp api", "gl": "us"},
    "routes": [
      {"provider": "anyapi", "endpoint": "google.search", "body": {"query": "$query", "gl": "$gl?", "hl": "$hl?"}},
      {"provider": "goanyapi", "endpoint": "serp-stable", "body": {"query": "$query", "gl": "$gl?", "hl": "$hl?"}},
      {"provider": "dataforseo", "endpoint": "serp/google/organic/live/regular",
       "body": {"keyword": "$query", "location_code": "$location_code=2840", "language_code": "$hl=en", "depth": 10},
       "note": "location by location_code (2840 = US); search operators cost 5x"}
    ]
  },
  "serp.bing": {
    "description": "Bing organic results, top 10 for one query",
    "input": {"query": "search query", "country": "country code, e.g. US (optional)"},
    "example": {"query": "cheap serp api"},
    "routes": [
      {"provider": "anyapi", "endpoint": "bing.search", "body": {"query": "$query", "country": "$country?"}},
      {"provider": "goanyapi", "endpoint": "bing-serp", "body": {"query": "$query", "cc": "$country?"}}
    ]
  },
  "x.search": {
    "description": "X (Twitter) search, one page of about 20 posts",
    "input": {"query": "X advanced search query", "queryType": "Latest or Top (optional)"},
    "example": {"query": "(serpapi OR dataforseo) pricing -filter:replies", "queryType": "Latest"},
    "routes": [
      {"provider": "anyapi", "endpoint": "twitter.search", "body": {"query": "$query", "queryType": "$queryType?"}},
      {"provider": "twitterapi", "endpoint": "twitter/tweet/advanced_search", "body": {"query": "$query", "queryType": "$queryType=Latest"},
       "note": "billed per returned post, minimum one post even when empty"}
    ]
  },
  "reddit.search": {
    "description": "Reddit post search, first page of about 25 posts",
    "input": {"query": "query; supports subreddit:, author:, title:", "sort": "relevance|hot|top|new|comments (optional)", "timeframe": "hour|day|week|month|year|all (optional)"},
    "example": {"query": "serp api pricing", "sort": "new"},
    "routes": [
      {"provider": "anyapi", "endpoint": "reddit.search", "body": {"query": "$query", "sort": "$sort?", "timeframe": "$timeframe?"},
       "note": "the cheapest source returns no nextCursor; paging costs 2.3x, so prefer more first pages with other sort/timeframe"}
    ]
  },
  "tiktok.search": {
    "description": "TikTok video search by keyword, one page of about 20 videos",
    "input": {"query": "keyword", "sortBy": "relevance|most-liked|date-posted (optional)", "datePosted": "0|1|7|30|90|180 (optional)"},
    "example": {"query": "ai video generator"},
    "routes": [
      {"provider": "anyapi", "endpoint": "tiktok.search_keyword", "body": {"query": "$query", "sortBy": "$sortBy?", "datePosted": "$datePosted?"}}
    ]
  },
  "google.trends": {
    "description": "Google Trends interest over time for up to 5 keywords",
    "input": {"keywords": "list of 1-5 keywords", "geo": "country code, e.g. US (optional)"},
    "example": {"keywords": ["serpapi", "dataforseo"], "geo": "US"},
    "routes": [
      {"provider": "anyapi", "endpoint": "google.trends", "body": {"keywords": "$keywords", "geo": "$geo?"}},
      {"provider": "goanyapi", "endpoint": "google-trends", "body": {"q": "$keywords|join", "geo": "$geo?"}, "price_per": "keywords",
       "note": "charged per keyword, empty results included"}
    ]
  },
  "keyword.volume": {
    "description": "Monthly Google search volume for a list of keywords",
    "input": {"keywords": "list of keywords", "location_code": "DataForSEO location code (optional, 2840 = US)", "language_code": "optional, default en"},
    "example": {"keywords": ["cheap serp api", "serpapi alternative"]},
    "routes": [
      {"provider": "dataforseo", "endpoint": "keywords_data/google_ads/search_volume/live",
       "body": {"keywords": "$keywords", "location_code": "$location_code=2840", "language_code": "$language_code=en"},
       "chunk": {"field": "keywords", "size": 1000},
       "note": "one price for up to 1,000 keywords: collect keywords and send them together"},
      {"provider": "goanyapi", "endpoint": "keyword-search-volume", "body": {"keyword": "$item"}, "each": "keywords",
       "note": "priced per keyword: cheaper than DataForSEO below about 30 keywords; US data"}
    ]
  },
  "keyword.ideas": {
    "description": "Keyword ideas around a seed keyword",
    "input": {"keyword": "seed keyword", "limit": "max ideas (optional, default 100)", "location_code": "optional, 2840 = US"},
    "example": {"keyword": "serp api", "limit": 100},
    "routes": [
      {"provider": "dataforseo", "endpoint": "dataforseo_labs/google/keyword_suggestions/live",
       "body": {"keyword": "$keyword", "location_code": "$location_code=2840", "language_code": "$language_code=en", "limit": "$limit=100"},
       "note": "with search volume, CPC and difficulty"},
      {"provider": "goanyapi", "endpoint": "keyword-generator", "body": {"keyword": "$keyword", "country": "$country?"},
       "note": "different data source and fields; check before mixing with DataForSEO numbers"}
    ]
  },
  "domain.rank": {
    "description": "DataForSEO domain rank and backlink counts for a list of domains",
    "input": {"domains": "list of domains"},
    "example": {"domains": ["serpapi.com", "dataforseo.com"]},
    "routes": [
      {"provider": "dataforseo", "endpoint": "backlinks/bulk_ranks/live", "body": {"targets": "$domains"},
       "chunk": {"field": "domains", "size": 1000}, "note": "batch up to 1,000 domains per call"}
    ]
  },
  "domain.dr": {
    "description": "Domain Rating (0-100) for a list of domains",
    "input": {"domains": "list of domains"},
    "example": {"domains": ["serpapi.com"]},
    "routes": [
      {"provider": "goanyapi", "endpoint": "dr", "body": {"domain": "$item"}, "each": "domains"}
    ]
  },
  "backlinks.summary": {
    "description": "Backlink overview of one domain",
    "input": {"domain": "domain"},
    "example": {"domain": "serpapi.com"},
    "routes": [
      {"provider": "goanyapi", "endpoint": "backlink", "body": {"domain": "$domain"}, "note": "dofollow counts are unreliable"},
      {"provider": "dataforseo", "endpoint": "backlinks/summary/live", "body": {"target": "$domain"}}
    ]
  },
  "website.traffic": {
    "description": "Estimated monthly website traffic history",
    "input": {"domain": "domain", "month": "3|6|12 months of history (optional)"},
    "example": {"domain": "serpapi.com"},
    "routes": [
      {"provider": "goanyapi", "endpoint": "traffic", "body": {"domain": "$domain", "month": "$month?"}}
    ]
  },
  "image.generate": {
    "description": "Text-to-image generation",
    "media": true,
    "input": {"prompt": "prompt", "model": "model id; compare first, then pass the one whose quality fits", "parameters": "model parameters, e.g. {\"resolution\": \"1K\"} (optional)"},
    "example": {"prompt": "a cardboard robot holding a price tag, studio light", "model": "google/nano-banana-2"},
    "routes": [
      {"provider": "yir", "endpoint": "image", "body": {"model": "$model", "prompt": "$prompt", "parameters": "$parameters?", "routing": "$routing?"},
       "models": ["google/nano-banana-2", "openai/gpt-image-2", "bytedance/seedream-5.0", "alibaba/z-image-turbo", "bfl/flux-2-flex"]}
    ]
  },
  "video.generate": {
    "description": "Text-to-video generation",
    "media": true,
    "input": {"prompt": "prompt", "model": "model id; compare first", "parameters": "e.g. {\"duration\": 5, \"resolution\": \"720p\"} (optional)"},
    "example": {"prompt": "a paper plane flying over a city at dusk", "model": "bytedance/seedance-2.0-fast"},
    "routes": [
      {"provider": "yir", "endpoint": "video", "body": {"model": "$model", "prompt": "$prompt", "parameters": "$parameters?", "routing": "$routing?"},
       "models": ["bytedance/seedance-2.0-fast", "google/veo-3.1-fast-generate-001", "klingai/kling-3.0", "alibaba/wan-2.7"]}
    ]
  },
  "speech.generate": {
    "description": "Text to speech; billed per character",
    "media": true,
    "input": {"prompt": "exact text to read aloud", "model": "model id", "parameters": "e.g. {\"voice\": \"ID\"} (optional)"},
    "example": {"prompt": "Compare prices before you call a paid API.", "model": "elevenlabs/eleven-v3"},
    "routes": [
      {"provider": "yir", "endpoint": "audio", "body": {"model": "$model", "prompt": "$prompt", "parameters": "$parameters?", "routing": "$routing?"},
       "models": ["elevenlabs/eleven-v3"]}
    ]
  }
}
